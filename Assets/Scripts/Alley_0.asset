  m_Script: {fileID: 11500000, guid: ad43bd934b591fe2cb6e443df01c7bb9, type: 3}
  m_Name: Alley_0
  m_EditorClassIdentifier: 
  lines:
  - 'NhuLu: PEOPLE HERE'
  - 'NhuLu: HOW LONG ARE WE GOING TO BE SILENT ON THIS DICTATORSHIP'
  - 'NhuLu: WE ELECTED THE BL4Z3 PARTY 2 YEARS AGO'
  - 'NhuLu: AND SINCE THEN, OUR LIFE HAS BECOME MEANINGLESS'
  - 'NhuLu: AND I REFUSE TO GIVE IT UP YET'
  - 'NhuLu: THE LEADER, THE SOLE PERSON BEHING THIS'
  - 'Shinoa: Hey, are you awake?'
  - 'NhuLu: THE PERSON NINJA, SHOULD BE BROUGHT TO JUSTICE'
  - 'Shinoa: Your face looks pale... your hand is bloddy...'
  - 'NhuLu: AND WE HAVE GOTTEN A INFORMATION THAT HIS FRIEND NAMED VIPER HAVE ARRIVED
    ON OUR LAND'
  - 'Shinoa: Um... your hands are bloody... did you fight someone?'
  - 'NhuLu: WE CANNOT LET HIM AND THE RUTHLESS NINJA JOIN TOGETHER'
  - 'NhuLu: SO EVERYONE, COMMAND WITH ME'
  - 'NhuLu: LET''S CHARGE TODAY AND KILL THEM BOTH'
  - 'NhuLu: NINJA'
  - 'Shinoa: Open your eyes'
  - 'NhuLu: VIPER'
